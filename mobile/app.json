{
  "expo": {
    "name": "시큐브리프",
    "slug": "secbrief",
    "version": "0.10.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "secbrief",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "kr.suhsaechan.secbrief",
      "appleTeamId": "CUK22HY6YC",
      "config": {
        "usesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:api.secbrief.suhsaechan.kr"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#131313",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "kr.suhsaechan.secbrief",
      "versionCode": 22,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "api.secbrief.suhsaechan.kr",
              "pathPrefix": "/a/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F4F0",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#131313"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#5200FF",
          "defaultChannel": "urgent-alerts"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
